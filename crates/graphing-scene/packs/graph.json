{
  "id": "graph",
  "name": "Node graph",
  "icon": "Workflow",
  "description": "Blueprint-style node graphs and DAGs: typed pins, curved wires, checked flow",
  "version": "1",
  "stencils": [
    {"name": "event", "title": "Event", "category": "Node graph", "outline": "rounded", "icon": "Zap", "defaults": {"stroke": "#b3261e"}, "pins": {"out": ["exec"]}},
    {"name": "function", "title": "Function", "category": "Node graph", "outline": "rect", "icon": "SquareFunction", "defaults": {"stroke": "#1e63c4"}, "pins": {"in": ["exec"], "out": ["exec"]}},
    {"name": "pure", "title": "Pure function", "category": "Node graph", "outline": "rect", "icon": "Sigma", "defaults": {"stroke": "#2e7d32"}},
    {"name": "branch", "title": "Branch", "category": "Node graph", "outline": "rect", "icon": "GitBranch", "defaults": {"stroke": "#616161"}, "pins": {"in": ["exec", "condition: bool"], "out": ["true: exec", "false: exec"]}},
    {"name": "sequence", "title": "Sequence", "category": "Node graph", "outline": "rect", "icon": "ListOrdered", "defaults": {"stroke": "#616161"}, "pins": {"in": ["exec"], "out": [{"name": "then {i}", "type": "exec", "count": "outputs", "default": 2}]}, "props": [{"key": "outputs", "label": "Outputs"}]},
    {"name": "switch", "title": "Switch", "category": "Node graph", "outline": "rect", "icon": "Split", "defaults": {"stroke": "#616161"}, "props": [{"key": "cases", "label": "Cases"}], "pins": {"in": ["exec", "selection: string"], "out": [{"name": "{item}", "type": "exec", "each": "cases"}, "default: exec"]}},
    {"name": "select", "title": "Select", "category": "Node graph", "outline": "rect", "icon": "ToggleLeft", "defaults": {"stroke": "#2e7d32"}, "pins": {"in": ["pick: bool", "a: T", "b: T"], "out": ["result: T"]}},
    {"name": "make-array", "title": "Make Array", "category": "Node graph", "outline": "rect", "icon": "Brackets", "defaults": {"stroke": "#2e7d32"}, "props": [{"key": "inputs", "label": "Inputs"}], "pins": {"in": [{"name": "[{i}]", "type": "T", "count": "inputs", "default": 2}], "out": ["array: list"]}},
    {"name": "variable", "title": "Variable", "category": "Node graph", "outline": "rounded", "icon": "Variable", "defaults": {"stroke": "#455a64"}, "pins": {"out": ["value"]}},
    {"name": "macro", "title": "Macro", "category": "Node graph", "outline": "rect", "icon": "Boxes", "defaults": {"stroke": "#6d4c41"}, "pins": {"in": ["exec"], "out": ["exec"]}},
    {"name": "task", "title": "Task", "category": "DAG", "outline": "rounded", "icon": "SquareCheck", "defaults": {"stroke": "#455a64"}},
    {"name": "source", "title": "Source", "category": "DAG", "outline": "cylinder", "icon": "Database"},
    {"name": "sink", "title": "Sink", "category": "DAG", "outline": "rounded", "icon": "Inbox"}
  ],
  "group_kinds": [
    {"name": "comment", "title": "Comment", "category": "Node graph", "look": "card", "icon": "MessageSquare", "description": "A titled box around part of the graph", "defaults": {"fill": "#fab005"}}
  ],
  "diagram_kinds": [
    {"id": "graph", "name": "Node graph", "context": "graph", "description": "Nodes with typed pins; data may not loop, execution may", "icon": "Workflow", "flow": "right", "acyclic": true},
    {"id": "dag", "name": "DAG", "context": "pipeline", "description": "Steps that never loop back: builds, pipelines, dependencies", "icon": "Network", "flow": "right", "acyclic": true}
  ]
}
